# Porta usada pela API localmente.
PORT=8081

# URI de conexão com o MongoDB.
MONGODB_URI=mongodb://localhost:27017/acta_db

# URL base da API PostgreSQL do ACTA.
ACTA_PG_API_BASE_URL=https://acta-pg-api.onrender.com

# URL base da API de notificações FCM do ACTA.
ACTA_FCM_API_URL=http://localhost:8000
ACTA_FCM_INTERNAL_TOKEN=gerar-segredo-compartilhado-com-acta-fcm-api